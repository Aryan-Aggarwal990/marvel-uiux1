# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API.
# Both values are PUBLIC by design (they ship to the browser); Row Level Security protects the data.
# Leave them empty to run the site without a backend (favourites stay in local storage).
#
# NEVER put the service_role / secret key here or anywhere in frontend code.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
